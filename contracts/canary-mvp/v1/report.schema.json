{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/canary-mvp/v1/report.schema.json",
  "title": "CanaryMvpReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordedAt",
    "canaryManifestDigest",
    "sourceSnapshotDigest",
    "canarySnapshotDigest",
    "coreReconciliationDigest",
    "semanticReconciliationId",
    "itemCount",
    "sourceReadBytes",
    "itemOutcomeBytes",
    "failureCount",
    "failures",
    "stateCounts",
    "stateBytes",
    "uniqueStoredObjects",
    "uniqueStoredBytes",
    "typedRecordCounts",
    "typedSourceItemCount",
    "typedRecordCount",
    "interpretations",
    "idempotentReplayVerified",
    "localBlobDataDisposable",
    "sqliteLocal",
    "nasRequired",
    "automaticActivationAuthorized",
    "providerDispatchAuthorized",
    "trainingAuthorized",
    "fullImportAuthorized",
    "manualInspectionRequired",
    "retainedLimitations",
    "rebuild",
    "reportDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tidy.canary-mvp-report/v1"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "canaryManifestDigest": {
      "const": "sha256:ee072650751fa76d456ba8cf034878a2a48137b02e6e7d459cb7945cb9474139"
    },
    "sourceSnapshotDigest": {
      "const": "sha256:2628b98976791c1996c0baafb22b2f8c9ee87a03e60b6cf0f4fbc5ff45ce8f4d"
    },
    "canarySnapshotDigest": {
      "$ref": "#/$defs/digest"
    },
    "coreReconciliationDigest": {
      "$ref": "#/$defs/digest"
    },
    "semanticReconciliationId": {
      "$ref": "#/$defs/digest"
    },
    "itemCount": {
      "const": 63
    },
    "sourceReadBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864,
      "const": 44084669
    },
    "stateCounts": {
      "$ref": "#/$defs/countMap"
    },
    "stateBytes": {
      "$ref": "#/$defs/countMap"
    },
    "uniqueStoredObjects": {
      "type": "integer",
      "minimum": 1,
      "maximum": 63
    },
    "uniqueStoredBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "typedRecordCounts": {
      "$ref": "#/$defs/countMap"
    },
    "typedSourceItemCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "typedRecordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 126
    },
    "idempotentReplayVerified": {
      "const": true
    },
    "sqliteLocal": {
      "const": true
    },
    "automaticActivationAuthorized": {
      "const": false
    },
    "providerDispatchAuthorized": {
      "const": false
    },
    "trainingAuthorized": {
      "const": false
    },
    "fullImportAuthorized": {
      "const": false
    },
    "manualInspectionRequired": {
      "const": true
    },
    "retainedLimitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "rebuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deleteOnly", "rerun"],
      "properties": {
        "deleteOnly": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rerun": {
          "const": "uv run python -m tidy_orchestrator.canary_mvp_cli run"
        }
      }
    },
    "reportDigest": {
      "$ref": "#/$defs/digest"
    },
    "localBlobDataDisposable": {
      "const": true
    },
    "nasRequired": {
      "const": false
    },
    "interpretations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibleSourceCounts",
        "approvalRegistry",
        "recipes",
        "generationProfiles",
        "providerDispatchAuthorized",
        "retryAuthorized",
        "activationAuthorized",
        "trainingEligible"
      ],
      "properties": {
        "eligibleSourceCounts": {
          "$ref": "#/$defs/countMap"
        },
        "approvalRegistry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interpretedSourceCount",
            "rowCount",
            "sourceContentDigests",
            "workerOutputContentDigests",
            "approvalAuthorityCreated",
            "targetsResolved"
          ],
          "properties": {
            "interpretedSourceCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "rowCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "approvalAuthorityCreated": {
              "const": false
            },
            "targetsResolved": {
              "const": false
            },
            "sourceContentDigests": {
              "type": "array",
              "maxItems": 63,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/digest"
              }
            },
            "workerOutputContentDigests": {
              "type": "array",
              "maxItems": 63,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "recipes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interpretedSourceCount",
            "schemaValidCount",
            "workerOutputContentDigests",
            "active",
            "trainingEligible"
          ],
          "properties": {
            "interpretedSourceCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "schemaValidCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "active": {
              "const": false
            },
            "trainingEligible": {
              "const": false
            },
            "workerOutputContentDigests": {
              "type": "array",
              "maxItems": 63,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "generationProfiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profiledSourceCount",
            "workerOutputContentDigests",
            "restrictedElementCount",
            "strictRecipeCandidateCount",
            "rawRestrictedTextEmitted"
          ],
          "properties": {
            "profiledSourceCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "restrictedElementCount": {
              "type": "integer",
              "minimum": 0
            },
            "strictRecipeCandidateCount": {
              "type": "integer",
              "minimum": 0
            },
            "rawRestrictedTextEmitted": {
              "const": false
            },
            "workerOutputContentDigests": {
              "type": "array",
              "maxItems": 63,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "providerDispatchAuthorized": {
          "const": false
        },
        "retryAuthorized": {
          "const": false
        },
        "activationAuthorized": {
          "const": false
        },
        "trainingEligible": {
          "const": false
        }
      }
    },
    "itemOutcomeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "failureCount": {
      "const": 0
    },
    "failures": {
      "type": "array",
      "maxItems": 63,
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "countMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
