{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/import/v1/digest-record-vectors.schema.json",
  "title": "HistoricalDigestRecordVectorsV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "source", "vectors"],
  "properties": {
    "schemaVersion": { "const": "tidycell-digest-record-vectors/v1" },
    "algorithm": { "const": "tidycell-digest-record-v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotDigest",
        "gitHead",
        "gitTree",
        "relativePath",
        "contentDigest"
      ],
      "properties": {
        "snapshotDigest": {
          "const": "sha256:2628b98976791c1996c0baafb22b2f8c9ee87a03e60b6cf0f4fbc5ff45ce8f4d"
        },
        "gitHead": { "const": "1be6c995fa931e9860468e40490433161b0121cb" },
        "gitTree": { "const": "96a76a1cbc6f2da3facd31d7cdae5b05926361d3" },
        "relativePath": {
          "const": "scripts/harvest/candidate-contract.ts"
        },
        "contentDigest": {
          "const": "sha256:ca0f38e741ba43886f809a2c96b782cec4db3a46787eb17f655fad019464114c"
        }
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "canonical", "digest"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "input": true,
          "canonical": { "type": "string", "maxLength": 1048576 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
