{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/import/v1/generation-evidence.schema.json",
  "title": "GenerationEvidenceImportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceSnapshotDigest",
    "sourceItemDigest",
    "sourceContentDigest",
    "relativePath",
    "sourceFinalState",
    "blobStored",
    "artifactClass",
    "interpretationStatus",
    "rawEvidenceRestricted",
    "embeddedRecords",
    "warnings",
    "producerDigest",
    "recordedAt",
    "actor",
    "recordId"
  ],
  "properties": {
    "schemaVersion": { "const": "tidy.generation-evidence-import/v1" },
    "sourceSnapshotDigest": { "$ref": "#/$defs/digest" },
    "sourceItemDigest": { "$ref": "#/$defs/digest" },
    "sourceContentDigest": { "$ref": "#/$defs/digest" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sourceFinalState": {
      "enum": ["imported", "duplicate-alias", "excluded", "quarantined"]
    },
    "blobStored": { "type": "boolean" },
    "artifactClass": { "type": "string", "minLength": 1, "maxLength": 128 },
    "interpretationStatus": { "const": "not-run" },
    "rawEvidenceRestricted": { "type": "boolean" },
    "embeddedRecords": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "pointer", "valueType"],
        "properties": {
          "kind": {
            "enum": [
              "recipe-document",
              "recipe-candidate",
              "prompt-evidence",
              "provider-response-evidence"
            ]
          },
          "pointer": { "type": "string", "maxLength": 8192 },
          "valueType": {
            "enum": [
              "null",
              "boolean",
              "object",
              "array",
              "string",
              "number",
              "unknown"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "producerDigest": { "$ref": "#/$defs/digest" },
    "recordedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "actor": { "type": "string", "minLength": 1, "maxLength": 256 },
    "recordId": { "$ref": "#/$defs/digest" }
  },
  "if": { "properties": { "sourceFinalState": { "const": "excluded" } } },
  "then": { "properties": { "blobStored": { "const": false } } },
  "else": { "properties": { "blobStored": { "const": true } } },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
