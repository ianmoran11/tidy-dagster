{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/import/v1/migration-worker-derivation.schema.json",
  "title": "MigrationWorkerDerivationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "derivationId",
    "operation",
    "contractVersion",
    "orderedInputDigests",
    "configurationDigest",
    "producerDigests",
    "orderedOutputDigests"
  ],
  "properties": {
    "schemaVersion": { "const": "tidy.migration-worker-derivation/v1" },
    "derivationId": { "$ref": "#/$defs/digest" },
    "operation": {
      "enum": [
        "health",
        "capabilities",
        "digest-legacy-approval-registry-v1",
        "parse-recipe-v01"
      ]
    },
    "contractVersion": { "const": "tidy.migration-worker/v1" },
    "orderedInputDigests": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/digest" }
    },
    "configurationDigest": { "$ref": "#/$defs/digest" },
    "producerDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/digest" }
    },
    "orderedOutputDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/digest" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
