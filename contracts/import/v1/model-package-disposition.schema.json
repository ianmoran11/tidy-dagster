{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/import/v1/model-package-disposition.schema.json",
  "title": "ModelPackageDispositionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceSnapshotDigest",
    "sourceItemDigest",
    "sourceContentDigest",
    "relativePath",
    "sourceFinalState",
    "blobStored",
    "eligibility",
    "runnable",
    "trainingEligible",
    "deserializationStatus",
    "reason",
    "producerDigest",
    "recordedAt",
    "actor",
    "recordId"
  ],
  "properties": {
    "schemaVersion": { "const": "tidy.model-package-disposition/v1" },
    "sourceSnapshotDigest": { "$ref": "#/$defs/digest" },
    "sourceItemDigest": { "$ref": "#/$defs/digest" },
    "sourceContentDigest": { "$ref": "#/$defs/digest" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sourceFinalState": {
      "enum": ["imported", "duplicate-alias", "excluded", "quarantined"]
    },
    "blobStored": { "type": "boolean" },
    "eligibility": { "const": "archival-unreviewed" },
    "runnable": { "const": false },
    "trainingEligible": { "const": false },
    "deserializationStatus": { "const": "not-attempted" },
    "reason": { "const": "UNREVIEWED_MODEL_PACKAGE" },
    "producerDigest": { "$ref": "#/$defs/digest" },
    "recordedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "actor": { "type": "string", "minLength": 1, "maxLength": 256 },
    "recordId": { "$ref": "#/$defs/digest" }
  },
  "if": { "properties": { "sourceFinalState": { "const": "excluded" } } },
  "then": { "properties": { "blobStored": { "const": false } } },
  "else": { "properties": { "blobStored": { "const": true } } },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
