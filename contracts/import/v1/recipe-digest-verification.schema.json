{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/import/v1/recipe-digest-verification.schema.json",
  "title": "RecipeDigestVerificationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithm",
    "sourceDigest",
    "declaredDigest",
    "computedDigest",
    "matches",
    "recipeContentDigest",
    "sourceSnapshotDigest",
    "sourceItemDigest",
    "importRecordId",
    "migrationWorkerOutputRecordId",
    "derivationId",
    "configurationDigest",
    "producerDigests",
    "verifierIsolationMode",
    "networkIsolationEnforced",
    "verificationAuthority",
    "verifierDigest",
    "verificationId"
  ],
  "properties": {
    "schemaVersion": { "const": "tidy.recipe-digest-verification/v1" },
    "algorithm": { "const": "tidycell-digest-record-v1" },
    "sourceDigest": {
      "const": "sha256:ca0f38e741ba43886f809a2c96b782cec4db3a46787eb17f655fad019464114c"
    },
    "declaredDigest": { "$ref": "#/$defs/digest" },
    "computedDigest": { "$ref": "#/$defs/digest" },
    "matches": { "type": "boolean" },
    "recipeContentDigest": { "$ref": "#/$defs/digest" },
    "sourceSnapshotDigest": { "$ref": "#/$defs/digest" },
    "sourceItemDigest": { "$ref": "#/$defs/digest" },
    "importRecordId": { "$ref": "#/$defs/digest" },
    "migrationWorkerOutputRecordId": { "$ref": "#/$defs/digest" },
    "derivationId": { "$ref": "#/$defs/digest" },
    "configurationDigest": { "$ref": "#/$defs/digest" },
    "producerDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "verifierIsolationMode": {
      "enum": ["macos-production", "insecure-test-only"]
    },
    "networkIsolationEnforced": { "type": "boolean" },
    "verificationAuthority": {
      "enum": ["gateway-production", "fixture-non-authoritative"]
    },
    "verifierDigest": { "$ref": "#/$defs/digest" },
    "verificationId": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verifierIsolationMode": { "const": "macos-production" }
        },
        "required": ["verifierIsolationMode"]
      },
      "then": {
        "properties": {
          "networkIsolationEnforced": { "const": true },
          "verificationAuthority": { "const": "gateway-production" }
        }
      },
      "else": {
        "properties": {
          "networkIsolationEnforced": { "const": false },
          "verificationAuthority": { "const": "fixture-non-authoritative" }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
