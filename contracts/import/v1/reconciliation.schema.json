{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/import/v1/reconciliation.schema.json",
  "title": "MigrationReconciliationReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotDigest",
    "inventoryDigest",
    "itemManifestDigest",
    "importerDigest",
    "blobStoreId",
    "contentReconciliationStatus",
    "phaseBStatus",
    "sourceItemCount",
    "sourceItemBytes",
    "stateCounts",
    "stateBytes",
    "uniqueStoredObjects",
    "uniqueStoredBytes",
    "mappingDigest",
    "mappings",
    "limitations",
    "reportDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "tidy.migration-reconciliation/v1" },
    "snapshotDigest": { "$ref": "#/$defs/digest" },
    "inventoryDigest": { "$ref": "#/$defs/digest" },
    "itemManifestDigest": { "$ref": "#/$defs/digest" },
    "importerDigest": { "$ref": "#/$defs/digest" },
    "blobStoreId": { "const": "committed-filesystem-sha256-v1" },
    "contentReconciliationStatus": { "const": "complete" },
    "phaseBStatus": {
      "const": "core-content-complete-semantic-import-pending"
    },
    "sourceItemCount": { "type": "integer", "minimum": 0 },
    "sourceItemBytes": { "type": "integer", "minimum": 0 },
    "stateCounts": { "$ref": "#/$defs/countMap" },
    "stateBytes": { "$ref": "#/$defs/countMap" },
    "uniqueStoredObjects": { "type": "integer", "minimum": 0 },
    "uniqueStoredBytes": { "type": "integer", "minimum": 0 },
    "mappingDigest": { "$ref": "#/$defs/digest" },
    "mappings": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relativePath",
          "sourceItemDigest",
          "proposedDisposition",
          "finalState",
          "sourceContentDigest",
          "contentDigest",
          "blobStored",
          "recordId"
        ],
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sourceItemDigest": { "$ref": "#/$defs/digest" },
          "proposedDisposition": {
            "enum": ["import", "duplicate-alias", "exclude", "quarantine"]
          },
          "finalState": {
            "enum": ["imported", "duplicate-alias", "excluded", "quarantined"]
          },
          "sourceContentDigest": {
            "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
          },
          "contentDigest": {
            "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
          },
          "blobStored": { "type": "boolean" },
          "recordId": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "reportDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "countMap": {
      "type": "object",
      "propertyNames": { "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
