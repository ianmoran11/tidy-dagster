{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/migration-worker/v1/error.schema.json",
  "title": "MigrationWorkerErrorV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "ok", "error"],
  "properties": {
    "protocolVersion": { "const": "tidy.migration-worker/v1" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ok": { "const": false },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "stage": {
          "enum": ["protocol", "input", "parse", "recipe", "limit", "output"]
        },
        "message": { "type": "string", "maxLength": 1024 },
        "details": true
      }
    }
  }
}
