{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/migration-worker/v1/success.schema.json",
  "title": "MigrationWorkerSuccessV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "ok", "outputs", "warnings"],
  "properties": {
    "protocolVersion": { "const": "tidy.migration-worker/v1" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ok": { "const": true },
    "outputs": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "relativePath", "contentDigest", "byteLength"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 0 }
  }
}
