{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/migration/v1/nas-commit.schema.json",
  "title": "NasSnapshotCommitV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotDigest",
    "inventoryDigest",
    "snapshotFileDigest",
    "snapshotFileBytes",
    "frozenAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tidy.nas-snapshot-commit/v1"
    },
    "snapshotDigest": {
      "$ref": "#/$defs/digest"
    },
    "inventoryDigest": {
      "$ref": "#/$defs/digest"
    },
    "snapshotFileDigest": {
      "$ref": "#/$defs/digest"
    },
    "snapshotFileBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741824
    },
    "frozenAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
