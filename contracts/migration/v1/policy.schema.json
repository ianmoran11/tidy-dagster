{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/migration/v1/policy.schema.json",
  "title": "tidy.source-export-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "sourceSystem",
    "limits",
    "rules",
    "fallbackFile"
  ],
  "properties": {
    "schemaVersion": { "const": "tidy.source-export-policy/v1" },
    "policyId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceSystem": { "type": "string", "minLength": 1, "maxLength": 64 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxEntries",
        "maxFileBytes",
        "maxJsonScanBytes",
        "maxJsonDepth",
        "maxEmbeddedRecordsPerFile"
      ],
      "properties": {
        "maxEntries": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "maxJsonScanBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "maxJsonDepth": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxEmbeddedRecordsPerFile": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/rule" }
    },
    "fallbackFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "disposition", "artifactClass"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "disposition": { "enum": ["import", "exclude", "quarantine"] },
        "artifactClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "entryTypes",
        "disposition",
        "artifactClass"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "entryTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["file", "directory", "symlink"] }
        },
        "pathPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safePath" }
        },
        "exactPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safePath" }
        },
        "suffixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "basenameGlobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "directoryNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "disposition": { "enum": ["import", "exclude", "quarantine"] },
        "artifactClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "anyOf": [
        { "required": ["pathPrefixes"] },
        { "required": ["exactPaths"] },
        { "required": ["suffixes"] },
        { "required": ["basenameGlobs"] },
        { "required": ["directoryNames"] }
      ]
    }
  }
}
