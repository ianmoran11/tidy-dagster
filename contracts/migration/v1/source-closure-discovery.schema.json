{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/migration/v1/source-closure-discovery.schema.json",
  "title": "SourceClosureDiscoveryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "completionStatus",
    "closureId",
    "frozenAt",
    "selectionPolicy",
    "sources",
    "totals",
    "producer",
    "manifestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "tidy.source-closure-discovery/v1" },
    "completionStatus": { "const": "complete-no-copy" },
    "closureId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "frozenAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sourceBytesCopied",
        "runtimeSiblingDependencyAllowed",
        "unresolvedRelativeImportCount"
      ],
      "properties": {
        "algorithm": { "const": "literal-typescript-import-closure-v1" },
        "sourceBytesCopied": { "const": false },
        "runtimeSiblingDependencyAllowed": { "const": false },
        "unresolvedRelativeImportCount": { "const": 0 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/source" }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCount", "itemCount", "byteLength"],
      "properties": {
        "sourceCount": { "const": 2 },
        "itemCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 33554432 }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceDigest", "canonicalizationAlgorithm"],
      "properties": {
        "version": { "const": "tidy-source-closure-discovery/v1" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "canonicalizationAlgorithm": { "const": "tidy-python-sorted-json-v1" }
      }
    },
    "manifestDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "role": {
      "enum": ["source", "fixture", "license", "manifest", "lockfile", "notice"]
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "role"],
      "properties": {
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "role": { "$ref": "#/$defs/role" }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sourceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "role",
        "sourceMode",
        "byteLength",
        "contentDigest",
        "gitBlobId",
        "phaseADisposition"
      ],
      "properties": {
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "role": { "$ref": "#/$defs/role" },
        "sourceMode": { "type": "integer", "minimum": 0 },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "gitBlobId": {
          "oneOf": [{ "$ref": "#/$defs/gitObject" }, { "type": "null" }]
        },
        "phaseADisposition": {
          "oneOf": [
            { "enum": ["import", "duplicate-alias"] },
            { "type": "null" }
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phaseASnapshotDigest",
        "gitHead",
        "gitTree",
        "trackedDirty",
        "trackedDirtyDigest",
        "selectedBytesMatchAuthority"
      ],
      "properties": {
        "phaseASnapshotDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "gitHead": { "$ref": "#/$defs/gitObject" },
        "gitTree": { "$ref": "#/$defs/gitObject" },
        "trackedDirty": {
          "oneOf": [{ "type": "boolean" }, { "type": "null" }]
        },
        "trackedDirtyDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "selectedBytesMatchAuthority": { "const": true }
      }
    },
    "externalImport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specifier", "importedBy"],
      "properties": {
        "specifier": { "type": "string", "minLength": 1, "maxLength": 512 },
        "importedBy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSystem",
        "sourceRootId",
        "readMode",
        "authority",
        "entrypoints",
        "items",
        "externalImports",
        "licenseDigest",
        "lockfileDigests",
        "itemCount",
        "totalBytes",
        "itemManifestDigest"
      ],
      "properties": {
        "sourceSystem": { "enum": ["tidycell", "tidybank"] },
        "sourceRootId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "readMode": { "enum": ["phase-a-filesystem", "git-object"] },
        "authority": { "$ref": "#/$defs/authority" },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/entrypoint" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/sourceItem" }
        },
        "externalImports": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/externalImport" }
        },
        "licenseDigest": { "$ref": "#/$defs/digest" },
        "lockfileDigests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/digest" }
        },
        "itemCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "totalBytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "itemManifestDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
