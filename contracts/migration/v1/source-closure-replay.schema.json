{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/migration/v1/source-closure-replay.schema.json",
  "title": "SourceClosureReplayV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "closureManifestDigest",
    "copyCommitDigest",
    "replayKind",
    "sourceSystem",
    "testFiles",
    "testFileCount",
    "testCount",
    "passedTestCount",
    "failedTestCount",
    "skippedTestCount",
    "sourceTreeDigestBefore",
    "sourceTreeDigestAfter",
    "harnessDigest",
    "runtime",
    "bundleVerifiedBefore",
    "bundleVerifiedAfter",
    "relocated",
    "runtimeSiblingDependencyUsed",
    "networkIsolationEnforced",
    "parityEstablished",
    "limitations",
    "recordedAt",
    "replayDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "tidy.source-closure-replay/v1" },
    "closureManifestDigest": { "$ref": "#/$defs/digest" },
    "copyCommitDigest": { "$ref": "#/$defs/digest" },
    "replayKind": { "const": "copied-source-owned-tests" },
    "sourceSystem": { "const": "tidycell" },
    "testFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "contentDigest"],
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "contentDigest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "testFileCount": { "type": "integer", "minimum": 1, "maximum": 100 },
    "testCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "passedTestCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "failedTestCount": { "const": 0 },
    "skippedTestCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "sourceTreeDigestBefore": { "$ref": "#/$defs/digest" },
    "sourceTreeDigestAfter": { "$ref": "#/$defs/digest" },
    "harnessDigest": { "$ref": "#/$defs/digest" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeVersion",
        "vitestVersion",
        "tidyDagsterLockDigest",
        "copiedSourceLockDigest",
        "dependencyRuntime"
      ],
      "properties": {
        "nodeVersion": { "const": "v24.7.0" },
        "vitestVersion": { "const": "4.1.5" },
        "tidyDagsterLockDigest": { "$ref": "#/$defs/digest" },
        "copiedSourceLockDigest": { "$ref": "#/$defs/digest" },
        "dependencyRuntime": { "const": "tidy-dagster-locked-node-modules" }
      }
    },
    "bundleVerifiedBefore": { "const": true },
    "bundleVerifiedAfter": { "const": true },
    "relocated": { "const": true },
    "runtimeSiblingDependencyUsed": { "const": false },
    "networkIsolationEnforced": { "const": true },
    "parityEstablished": { "const": false },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "recordedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "replayDigest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "properties": {
        "sourceTreeDigestAfter": { "$ref": "#/$defs/digest" }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
