{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/migration/v1/source-closure-review.schema.json",
  "title": "SourceClosureSelfReviewV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "closureManifestDigest",
    "reviewKind",
    "status",
    "reviewedAt",
    "reviewer",
    "checks",
    "claims",
    "limitations",
    "reviewDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "tidy.source-closure-self-review/v1" },
    "closureManifestDigest": { "$ref": "#/$defs/digest" },
    "reviewKind": { "const": "implementing-agent-self-review" },
    "status": { "const": "accepted-for-bounded-copy-and-parity-work" },
    "reviewedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "reviewer": { "const": "tidy-dagster-implementing-agent" },
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "status": { "const": "pass" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independentReview",
        "parityEstablished",
        "sourceBytesCopied",
        "runtimeSiblingDependencyAllowed"
      ],
      "properties": {
        "independentReview": { "const": false },
        "parityEstablished": { "const": false },
        "sourceBytesCopied": { "const": false },
        "runtimeSiblingDependencyAllowed": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "reviewDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
