{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidy-dagster.invalid/contracts/product-prototype/v1/cohort.schema.json",
  "title": "Tidy product prototype cohort v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cohortId",
    "publicationId",
    "tableFamilyId",
    "generation",
    "acceptanceContract",
    "workbooks"
  ],
  "properties": {
    "schemaVersion": { "const": "tidy.product-prototype-cohort/v1" },
    "cohortId": { "type": "string", "minLength": 1 },
    "publicationId": { "type": "string", "minLength": 1 },
    "tableFamilyId": { "type": "string", "minLength": 1 },
    "acceptanceContract": { "type": "string", "minLength": 1 },
    "workerLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxWarnings": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reasoning",
        "promptContract",
        "maximumCalls",
        "maximumCostUsd",
        "correctionPolicy"
      ],
      "properties": {
        "provider": { "const": "openai-codex" },
        "model": { "const": "openai-codex/gpt-5.6-luna" },
        "reasoning": { "const": "high" },
        "promptContract": {
          "const": "cell-role-semantic-map-v13-adjacent-year-aware"
        },
        "maximumCalls": { "type": "integer", "minimum": 2, "maximum": 24 },
        "maximumCostUsd": { "type": "number", "exclusiveMinimum": 0 },
        "correctionPolicy": {
          "const": "one-pre-execution-compilation-correction-only"
        }
      }
    },
    "workbooks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "referenceDate",
          "path",
          "contentDigest",
          "byteLength",
          "sheet",
          "replayResponse"
        ],
        "properties": {
          "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
          "referenceDate": { "type": "string", "format": "date" },
          "path": { "type": "string", "minLength": 1 },
          "contentDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "byteLength": { "type": "integer", "minimum": 1 },
          "sheet": { "type": "string", "minLength": 1 },
          "normalization": {
            "enum": [
              "isolate-repeated-total-label-formatting-v1",
              "trim-pathological-full-width-formatting-merge-v1",
              "trim-pathological-styled-blank-cells-v1",
              "trim-table-37-and-isolate-repeated-total-label-formatting-v1",
              "digest-pinned-bounded-offenders-remaining-v1"
            ]
          },
          "releaseId": {
            "type": "string",
            "pattern": "^20[0-9]{2}-[0-9]{2}$"
          },
          "downloadOrdinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "cubeId": { "type": "string", "minLength": 1 },
          "tableNamespace": { "type": "string", "minLength": 1 },
          "replayResponse": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "contentDigest",
              "byteLength",
              "historicalModel",
              "acceptanceAuthority"
            ],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "contentDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "byteLength": { "type": "integer", "minimum": 1 },
              "historicalModel": { "type": "string", "minLength": 1 },
              "acceptanceAuthority": { "const": false },
              "recipeProtocol": {
                "enum": ["RecipeV01", "TargetScopedRecipeV02"]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                { "required": ["releaseId"] },
                { "required": ["downloadOrdinal"] },
                { "required": ["cubeId"] },
                { "required": ["tableNamespace"] },
                {
                  "required": ["replayResponse"],
                  "properties": {
                    "replayResponse": {
                      "required": ["historicalModel"],
                      "properties": {
                        "historicalModel": {
                          "pattern": "^provider-free/offenders-c4/"
                        }
                      }
                    }
                  }
                },
                {
                  "required": ["normalization"],
                  "properties": {
                    "normalization": {
                      "const": "digest-pinned-bounded-offenders-remaining-v1"
                    }
                  }
                },
                {
                  "required": ["replayResponse"],
                  "properties": {
                    "replayResponse": { "required": ["recipeProtocol"] }
                  }
                }
              ]
            },
            "then": {
              "required": [
                "releaseId",
                "downloadOrdinal",
                "cubeId",
                "tableNamespace"
              ],
              "properties": {
                "replayResponse": {
                  "required": ["recipeProtocol"],
                  "oneOf": [
                    {
                      "properties": {
                        "recipeProtocol": { "const": "RecipeV01" },
                        "historicalModel": {
                          "enum": [
                            "provider-free/offenders-c4/semantic-map-v1-recipe-v01",
                            "provider-free/offenders-c4/semantic-map-v2-recipe-v01"
                          ]
                        }
                      }
                    },
                    {
                      "properties": {
                        "recipeProtocol": {
                          "const": "TargetScopedRecipeV02"
                        },
                        "historicalModel": {
                          "const": "provider-free/offenders-c4/target-scoped-recipe-v02"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workbooks": {
            "contains": {
              "anyOf": [
                { "required": ["releaseId"] },
                { "required": ["downloadOrdinal"] },
                { "required": ["cubeId"] },
                { "required": ["tableNamespace"] },
                {
                  "required": ["replayResponse"],
                  "properties": {
                    "replayResponse": {
                      "required": ["historicalModel"],
                      "properties": {
                        "historicalModel": {
                          "pattern": "^provider-free/offenders-c4/"
                        }
                      }
                    }
                  }
                },
                {
                  "required": ["normalization"],
                  "properties": {
                    "normalization": {
                      "const": "digest-pinned-bounded-offenders-remaining-v1"
                    }
                  }
                },
                {
                  "required": ["replayResponse"],
                  "properties": {
                    "replayResponse": { "required": ["recipeProtocol"] }
                  }
                }
              ]
            }
          }
        },
        "required": ["workbooks"]
      },
      "then": {
        "properties": {
          "publicationId": { "const": "recorded-crime-offenders" }
        }
      }
    }
  ]
}
